#!/usr/bin/make -f

export PYBUILD_NAME = migen

%:
	dh $@ --with python3 --buildsystem=pybuild

# pyproject.toml spells the licence as a PEP 639 SPDX string
# (license = "BSD-2-Clause"), which setuptools only accepts from 77 on.
# Bookworm has 66, whose schema check rejects it and fails the build, so
# there (and only there) the field is rewritten to the older table form
# for the build and put back afterwards. Newer setuptools gets upstream's
# file untouched: they deprecate the table form.
LICENSE_COMPAT = debian/.license-compat

execute_before_dh_auto_configure:
	if python3 -c 'import setuptools, sys; sys.exit(int(setuptools.__version__.split(".")[0]) >= 77)'; then \
		sed -i 's/^license = "\(.*\)"$$/license = {text = "\1"}/' pyproject.toml; \
		touch $(LICENSE_COMPAT); \
	fi

execute_after_dh_clean:
	if [ -e $(LICENSE_COMPAT) ]; then \
		sed -i 's/^license = {text = "\(.*\)"}$$/license = "\1"/' pyproject.toml; \
		rm -f $(LICENSE_COMPAT); \
	fi

# Upstream's suite (migen/test) runs examples/ from the source tree, which
# the pybuild build directory doesn't have. deb.yml's test job runs it in
# each suite's container instead.
override_dh_auto_test:
	:
