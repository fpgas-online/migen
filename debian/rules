#!/usr/bin/make -f

export PYBUILD_NAME = migen

%:
	dh $@ --with python3 --buildsystem=pybuild

# Older setuptools (bookworm's 66) can't build upstream's pyproject.toml as it
# is: see debian/pyproject-compat.py, which changes only what this suite needs
# and puts upstream's file back afterwards.
execute_before_dh_auto_configure:
	python3 debian/pyproject-compat.py apply

execute_after_dh_clean:
	python3 debian/pyproject-compat.py restore

# Upstream's suite (migen/test) runs examples/ from the source tree, which
# the pybuild build directory doesn't have. deb.yml's test job runs it in
# each suite's container instead.
override_dh_auto_test:
	:
